# Minimal workflow exercising the pixi software deployment plugin.
#
# The `curl` binary is provided by the "tools" environment defined in
# pixi.toml. With no `workspace` given, the plugin resolves it to the workflow
# root (cwd) -- so this Snakefile is meant to run from *inside* a pixi
# workspace (see tests/test_real.py, which copies tests/test_workspace next to
# a copy of this file).
#
# The rule records where `curl` resolves to so the test can prove the command
# ran inside the deployed pixi env (its path should live under
# .pixi/envs/tools/bin), not against a system curl on PATH.


rule all:
    input:
        "results/curl_version.txt",


rule curl_version:
    output:
        "results/curl_version.txt",
    software:
        pixi(env="tools")
    shell:
        "command -v curl > {output} && curl --version >> {output}"
